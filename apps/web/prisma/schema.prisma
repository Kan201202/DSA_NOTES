generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id        String   @id
  email     String   @unique
  cfHandle  String?
  lcHandle  String?
  createdAt DateTime @default(now())
}